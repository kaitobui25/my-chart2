# Copy this file to .env. The real .env file is ignored by Git.
FIINQUANT_USERNAME=
FIINQUANT_PASSWORD=

# Required for /session, /history, /symbols, and /stream.
# Generate with: openssl rand -hex 32
SIDECAR_TOKEN=

# Optional runtime settings.
# PORT=8720
# SIDECAR_BIND_ADDRESS=127.0.0.1

# Loopback workstation origins are allowed on any port by default.
# Add exact comma-separated LAN/Tailscale origins that may call the sidecar.
# SIDECAR_ALLOWED_ORIGINS=http://100.x.y.z:53175

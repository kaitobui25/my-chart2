# Copy this file to .env. The real .env file is ignored by Git.
# When both credentials are set, `npm run dev` auto-starts the sidecar and
# signs in before opening the workstation, so the browser Sign in step is skipped.
FIINQUANT_USERNAME=
FIINQUANT_PASSWORD=

# Required for /session, /history, /symbols, and /stream.
# `npm run dev` reads this value and passes it to the local Vite proxy automatically.
# Generate with: openssl rand -hex 32
SIDECAR_TOKEN=

# Optional runtime settings.
# PORT=8720
# SIDECAR_BIND_ADDRESS=127.0.0.1

# Loopback workstation origins are allowed on any port by default.
# Add exact comma-separated LAN/Tailscale origins that may call the sidecar.
# SIDECAR_ALLOWED_ORIGINS=http://100.x.y.z:53175

# Optional local dev proxy credentials.
# Copy to .env when you want DNSE signing to stay in the Vite dev/preview server.
# Never commit the real .env file.
DNSE_API_KEY=
DNSE_API_SECRET=

# Optional FiinQuant server mode. Must match SIDECAR_TOKEN in the sidecar .env.
# The Vite proxy injects it only for clients running on this machine.
FIINQUANT_SIDECAR_TOKEN=

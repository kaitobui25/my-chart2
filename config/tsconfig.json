{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "../src",
    "../examples/workstation",
    "../examples/providers",
    "../tests",
    "./playwright.config.ts",
    "./vitest.config.ts"
  ],
  "exclude": ["../examples/workstation/vite.config.ts"]
}

# Copy these values into a LOCAL file named .env.ssi-probe at the repository root.
# .env.ssi-probe is already ignored by the repository's .gitignore.
# Never commit real SSI credentials or access tokens.
SSI_API_KEY=
SSI_API_SECRET=

# Optional: skip the auth endpoint and use an existing Market Data bearer token.
# Prefer API key + secret for the first real-machine probe so auth latency is measured too.
# SSI_ACCESS_TOKEN=

# Production is the default. Override only if you intentionally test another SSI environment.
SSI_BASE_URL=https://api.ssi.com.vn

# First symbol is the cold-load target. Second symbol measures switching to another uncached ticker.
SSI_PROBE_SYMBOLS=PGI,SSI

# Three repeats are enough for an initial warm-latency sample without wasting rate limit.
SSI_PROBE_ITERATIONS=3
SSI_PROBE_TIMEOUT_MS=10000
SSI_PROBE_GAP_MS=250

# The probe tests these page sizes exactly; this tells us whether 500 candles can arrive in one request.
SSI_PROBE_PAGE_SIZES=10,100,500,1000

# Optional fixed ranges. Leave unset to use automatic ranges (about 900 days daily / 45 days intraday).
# SSI_PROBE_DAILY_FROM=2024/01/01
# SSI_PROBE_DAILY_TO=2026/08/09
# SSI_PROBE_INTRADAY_FROM=2026/07/01 00:00:00
# SSI_PROBE_INTRADAY_TO=2026/08/09 23:59:59

# Keep 1 so the representative cold 500-candle response is preserved for integration analysis.
SSI_PROBE_CAPTURE_FULL=1

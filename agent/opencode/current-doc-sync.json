{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "deny",
      "docs/current/README.md": "allow",
      "docs/current/ARCHITECTURE.md": "allow",
      "docs/current/FEATURES.md": "allow",
      "docs/current/DATA_SOURCES.md": "allow",
      "docs/current/SCANNER.md": "allow",
      "docs/current/REPLAY.md": "allow",
      "docs/current/OPERATIONS.md": "allow",
      "docs/current/RECENT_CHANGES.md": "allow"
    },
    "bash": {
      "*": "deny",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "git rev-parse*": "allow",
      "git cat-file*": "allow",
      "git merge-base*": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "question": "deny",
    "task": "deny",
    "external_directory": "deny"
  }
}

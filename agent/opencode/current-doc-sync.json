{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "deny",
      "docs/current/**": "allow"
    },
    "bash": {
      "*": "deny",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "git rev-parse*": "allow",
      "git cat-file*": "allow",
      "git merge-base*": "allow",
      "date *": "allow",
      "node scripts/check-current-docs.mjs": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "question": "deny",
    "task": "deny",
    "external_directory": "deny"
  }
}
